# ── AI / Gemini ─────────────────────────────────────────────────────────────
# Google Gemini API Key (used by core/aiClient.js for ai_query fallback)
# On first launch, saved to the OS keychain and blanked from .env.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# ── TTS / ElevenLabs ────────────────────────────────────────────────────────
# ElevenLabs TTS API key (used by services/tts/elevenLabsTts.js)
ELEVENLABS_API_KEY=
# Voice name — backend resolves voice_id by listing /v1/voices on first use.
ELEVENLABS_VOICE_NAME=Eva - Futuristic Robot Helper
# Optional: skip lookup and use this voice_id directly
# ELEVENLABS_FALLBACK_VOICE_ID=
# Model used for synthesis
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=development
# HTTP_SERVER_PORT=3001

# ── Chat history / MongoDB ───────────────────────────────────────────────────
# Optional. When set, NIMO stores user and assistant messages in MongoDB.
# Leave blank to keep the current in-memory-only behavior.
# MONGODB_URI=mongodb://127.0.0.1:27017
# MONGODB_DB_NAME=nimo
